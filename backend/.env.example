# Smart Resume Analyzer - Backend Environment Configuration

# Primary AI: Google Gemini API Key (Required - powers ATS rewrites, interviews, reports & audio transcription)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Models (Optional overrides)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite

# Optional Fallback Providers (Only used if configured)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# JWT Authentication
JWT_SECRET=smart_resume_analyzer_secret_dev_key_2026_xyz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL (Defaults to local SQLite)
DATABASE_URL=sqlite:///./smart_resume.db

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

# Server Port and Host
PORT=8000
HOST=0.0.0.0
