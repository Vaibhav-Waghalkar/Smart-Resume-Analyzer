# Smart Resume Analyzer - Backend Environment Variables

# Google Gemini API Key (Required for AI Suggestions, Bullet point rewrites, ATS analysis, and Interview Evaluation)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Optional / Fallback for Fast Inference and Whisper Audio Transcription)
GROQ_API_KEY=your_groq_api_key_here

# JWT Authentication Secret
JWT_SECRET=supersecret_jwt_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL (Defaults to local SQLite, can be swapped for PostgreSQL / Supabase)
DATABASE_URL=sqlite:///./smart_resume.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server Port and Host
PORT=8000
HOST=0.0.0.0
